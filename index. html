            if (!sb) return;
            try {
                const { data } = await sb.auth.getSession();
                if (data && data.session) {
                    adminAktif = true;
                    sessionStorage.setItem('alkes_admin_session', 'true');
                } else {
                    adminAktif = false;
                    if (sessionStorage.getItem('alkes_admin_session') !== 'true') {
                        document.getElementById('admin-page').classList.add('hidden');
                        document.getElementById('store-page').classList.remove('hidden');
                    }
                }
                await muatDariDatabase();
            } catch (err) {
                console.error(err);
            }
        }

