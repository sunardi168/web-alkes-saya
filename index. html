            document.getElementById('modal-login').classList.remove('hidden'); 
        }

        function tutupLogin() { 
            document.getElementById('modal-login').classList.add('hidden'); 
        }

        async function prosesLogin() {
            const email = document.getElementById('login-email').value.trim();
            const password = document.getElementById('login-password').value;
            const btnMasuk = document.getElementById('btn-submit-login');

            if (!email || !password) {
                return tampilkanToast("Harap masukkan email dan password!", "warning");
            }

            btnMasuk.disabled = true;
            btnMasuk.innerText = "Memproses...";

            try {
                const { data, error } = await sb.auth.signInWithPassword({ email, password });
                
                if (error) {
                    let pesanError = "Email atau password salah!";
                    if (error.message.includes("Email not confirmed")) {
                        pesanError = "Email belum dikonfirmasi di Supabase! Harap konfirmasi email atau centang Auto Confirm di Supabase.";
                    } else if (error.message.includes("Failed to fetch")) {
                        pesanError = "Gagal terhubung ke Supabase. Periksa koneksi internet Anda!";
                    } else if (error.message) {
                        pesanError = error.message;
                    }
                    return tampilkanToast(pesanError, "error");
                }

                adminAktif = true;
                document.getElementById('login-password').value = "";
                tutupLogin();
                await muatDariDatabase();
                masukAdminLokal();
            } catch (err) {
                tampilkanToast("Kendala: " + err.message, "error");
            } finally {
                btnMasuk.disabled = false;
                btnMasuk.innerText = "Masuk dengan Supabase";
            }
        }

