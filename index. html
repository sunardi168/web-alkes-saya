            const produk = daftarProduk.find(p => p.id === id);
            if (!item) return;

            item.qty += delta;
            if (item.qty <= 0) {
                keranjang = keranjang.filter(i => i.id !== id);
            } else if (produk && item.qty > produk.stok) {
                item.qty = produk.stok;
                tampilkanToast(`Stok maksimal ${produk.stok}`, "warning");
            }

            localStorage.setItem('alkes_cart', JSON.stringify(keranjang));
            perbaruiBadgeCart();
            renderIsiKeranjang();
        }

        function hapusDariKeranjang(id) {
            keranjang = keranjang.filter(i => i.id !== id);
            localStorage.setItem('alkes_cart', JSON.stringify(keranjang));
            perbaruiBadgeCart();
            renderIsiKeranjang();
            tampilkanToast("Produk dihapus dari keranjang", "info");
        }

        function renderIsiKeranjang() {
            const container = document.getElementById('isi-keranjang');
            const totalQtyEl = document.getElementById('cart-total-qty');
            const totalHargaEl = document.getElementById('cart-total-harga');
            const formArea = document.getElementById('form-checkout-area');

            if (keranjang.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10">
                        <i class="fa-solid fa-basket-shopping text-4xl text-slate-300 mb-2"></i>
                        <p class="text-xs text-slate-500">Keranjang belanja Anda masih kosong.</p>
                    </div>
                `;
                totalQtyEl.innerText = "0 pcs";
                totalHargaEl.innerText = "Rp 0";
                formArea.classList.add('hidden');
                return;
            }

            formArea.classList.remove('hidden');
            let totalHarga = 0;
            let totalQty = 0;

            container.innerHTML = keranjang.map(item => {
                const subtotal = item.harga * item.qty;
                totalHarga += subtotal;
                totalQty += item.qty;

                return `
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-xl border border-slate-200">
                        <div class="flex items-center space-x-2.5 flex-1 min-w-0 pr-2">
                            <img src="${item.foto}" class="w-12 h-12 object-contain bg-white rounded-lg p-1 border">
                            <div class="truncate">
                                <h4 class="font-bold text-xs text-slate-800 truncate">${item.nama}</h4>
                                <div class="text-[11px] text-alkes-700 font-semibold">${formatRupiah(item.harga)}</div>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <div class="flex items-center border border-slate-300 rounded-lg bg-white overflow-hidden">
                                <button onclick="ubahJumlahKeranjang(${item.id}, -1)" class="px-2 py-1 text-xs text-slate-600 hover:bg-slate-100">-</button>
                                <span class="px-2 text-xs font-bold text-slate-800">${item.qty}</span>
                                <button onclick="ubahJumlahKeranjang(${item.id}, 1)" class="px-2 py-1 text-xs text-slate-600 hover:bg-slate-100">+</button>
                            </div>
                            <button onclick="hapusDariKeranjang(${item.id})" class="text-rose-500 hover:text-rose-700 p-1">
                                <i class="fa-solid fa-trash-can text-xs"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            totalQtyEl.innerText = totalQty + " pcs";
            totalHargaEl.innerText = formatRupiah(totalHarga);
        }

        /* ================= PESANAN WHATSAPP ================= */
        function formatNomorWA(nomor) {
            let clean = nomor.replace(/\D/g, '');
            if (clean.startsWith('0')) clean = '62' + clean.slice(1);
            return clean;
        }

        function pesanLangsungWA(id) {
            const produk = daftarProduk.find(p => p.id === id);
            if (!produk) return;

            const pesan = `Halo Admin TOKO ALKES INDONESIA,\n\nSaya ingin memesan alat kesehatan berikut:\n- *Produk:* ${produk.nama}\n- *Merek:* ${produk.merek}\n- *Harga:* ${formatRupiah(produk.harga)}\n- *Jumlah:* 1 unit\n\nApakah stok masih tersedia? Terima kasih.`;
            const url = `https://wa.me/${formatNomorWA(nomorWaToko)}?text=${encodeURIComponent(pesan)}`;
            window.open(url, '_blank');
        }

        function prosesCheckoutWA() {
            if (keranjang.length === 0) {
                tampilkanToast("Keranjang belanja masih kosong!", "warning");
                return;
            }

            const nama = document.getElementById('checkout-nama').value.trim();
            const wa = document.getElementById('checkout-wa').value.trim();
            const alamat = document.getElementById('checkout-alamat').value.trim();
            const catatan = document.getElementById('checkout-catatan').value.trim() || "-";

            if (!nama || !wa || !alamat) {
                tampilkanToast("Lengkapi Nama, WhatsApp, dan Alamat Anda!", "warning");
                return;
            }

            let daftarBarangTeks = "";
            let totalBiaya = 0;

            keranjang.forEach((item, index) => {
                const sub = item.harga * item.qty;
                totalBiaya += sub;
                daftarBarangTeks += `${index + 1}. ${item.nama} (${item.qty} pcs) - ${formatRupiah(sub)}\n`;
            });

            const pesanWA = 
`*PESANAN BARU - TOKO ALKES INDONESIA*
================================
*DATA PEMBELI:*
• Nama: ${nama}
• No. WhatsApp: ${wa}
• Alamat Pengiriman: ${alamat}
• Catatan Khusus: ${catatan}

================================
*DAFTAR PRODUK ALKES:*
${daftarBarangTeks}
================================
*TOTAL TAGIHAN: ${formatRupiah(totalBiaya)}*
================================

Mohon segera konfirmasi ketersediaan pesanan saya. Terima kasih!`;

            const orderBaru = {
                id: 'INV-' + Date.now().toString().slice(-6),
                tanggal: new Date().toLocaleString('id-ID'),
                nama: nama,
                wa: wa,
                alamat: alamat,
                catatan: catatan,
                items: [...keranjang],
                total: totalBiaya,
                status: 'Diproses'
            };
            daftarPesanan.unshift(orderBaru);
            localStorage.setItem('alkes_pesanan', JSON.stringify(daftarPesanan)); 
            dbSimpanPesanan(orderBaru);

            keranjang = [];
            localStorage.setItem('alkes_cart', JSON.stringify(keranjang));
            perbaruiBadgeCart();
            tutupKeranjang();

            const targetNomor = formatNomorWA(nomorWaToko);
            const waUrl = `https://wa.me/${targetNomor}?text=${encodeURIComponent(pesanWA)}`;
            window.open(waUrl, '_blank');
        }

        /* ================= DETAIL MODAL ================= */
        function bukaDetailModal(id) {
            const p = daftarProduk.find(item => item.id === id);
            if (!p) return;

            document.getElementById('detail-foto').src = p.foto;
            document.getElementById('detail-kategori').innerText = p.kategori;
            document.getElementById('detail-merek').innerText = p.merek;
            document.getElementById('detail-nama').innerText = p.nama;
            document.getElementById('detail-harga').innerText = formatRupiah(p.harga);
            document.getElementById('detail-deskripsi').innerText = p.deskripsi;
            document.getElementById('detail-stok').innerText = p.stok + " unit";

            document.getElementById('btn-tambah-detail').onclick = () => {
                tambahKeKeranjang(p.id);
