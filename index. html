        function dbGagal(e) { console.error(e); tampilkanToast("Gagal menyimpan ke database", "error"); }
        
        async function dbSimpanProduk() {
            if (!sb || !adminAktif) return;
            const ids = daftarProduk.map(p => p.id);
            let r = await sb.from('produk').upsert(daftarProduk.map(p => ({ id: p.id, data: p })));
            if (r.error) return dbGagal(r.error);
            const hapus = dbIdProduk.filter(i => !ids.includes(i));
            if (hapus.length) { 
                r = await sb.from('produk').delete().in('id', hapus); 
                if (r.error) dbGagal(r.error); 
            }
            dbIdProduk = ids;
        }

        async function dbSimpanPesanan(o) {
            if (!sb || !o) return;
            const row = { id: String(o.id), data: o };
            const r = adminAktif ? await sb.from('pesanan').upsert(row) : await sb.from('pesanan').insert(row);
            if (r.error) console.error(r.error);
        }

        async function dbSimpanPengaturan() {
            if (!sb || !adminAktif) return;
            const r = await sb.from('pengaturan').upsert({ kunci: 'wa_toko', nilai: nomorWaToko });
            if (r.error) dbGagal(r.error);
