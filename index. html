<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>TOKO ALKES INDONESIA - Alat Kesehatan Terpercaya</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome untuk Ikon Medis -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        alkes: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        body { -webkit-tap-highlight-color: transparent; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col pb-16">

    <!-- TOAST NOTIFIKASI -->
    <div id="toast-container" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 w-11/12 max-w-sm pointer-events-none"></div>

    <!-- ==================== HALAMAN PENGUNJUNG / TOKO ==================== -->
    <div id="store-page" class="w-full">
        <!-- Header & Navigasi -->
        <header class="bg-gradient-to-r from-alkes-700 to-alkes-600 text-white sticky top-0 z-30 shadow-md">
            <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
                <div class="flex items-center space-x-2.5">
                    <div class="w-10 h-10 rounded-xl bg-white text-alkes-700 flex items-center justify-center font-bold text-xl shadow-inner">
                        <i class="fa-solid fa-notes-medical"></i>
                    </div>
                    <div>
                        <h1 class="font-extrabold text-base md:text-lg tracking-wide uppercase leading-tight">TOKO ALKES INDONESIA</h1>
                        <p class="text-xs text-alkes-100 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block animate-pulse"></span> Medis & Laboratorium
                        </p>
                    </div>
                </div>
                
                <div class="flex items-center space-x-2">
                    <!-- Tombol Login Admin (disembunyikan; muncul setelah kode rahasia diketik) -->
                    <button id="btn-menu-login" onclick="bukaLogin()" title="Login Admin" class="hidden p-2 sm:px-3 sm:py-2 bg-alkes-800/60 hover:bg-alkes-800 rounded-xl transition duration-200 flex items-center gap-1.5 text-xs font-bold border border-white/10">
                        <i class="fa-solid fa-user-shield text-base text-teal-200"></i>
                        <span class="hidden sm:inline">Admin</span>
                    </button>

                    <!-- Tombol Keranjang -->
                    <button onclick="bukaKeranjang()" class="relative p-2.5 bg-alkes-800/40 hover:bg-alkes-800 rounded-xl transition duration-200">
                        <i class="fa-solid fa-cart-shopping text-lg"></i>
                        <span id="badge-cart" class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full hidden">0</span>
                    </button>
                </div>
            </div>

            <!-- Kolom Pencarian -->
            <div class="max-w-4xl mx-auto px-4 pb-3">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400"></i>
                    <input type="text" id="input-pencarian" oninput="cariDanFilterProduk()" 
                           placeholder="Cari tensimeter, nebulizer, oximeter..." 
                           class="w-full pl-10 pr-4 py-2.5 rounded-xl text-slate-800 text-sm bg-white shadow-inner focus:outline-none focus:ring-2 focus:ring-teal-300">
                </div>
            </div>
        </header>

        <!-- Kategori -->
        <div class="max-w-4xl mx-auto px-4 py-3">
            <div class="flex space-x-2 overflow-x-auto no-scrollbar py-1" id="kategori-container"></div>
        </div>

        <!-- Banner Info WhatsApp -->
        <div class="max-w-4xl mx-auto px-4 mb-3">
            <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-3 flex items-center justify-between text-xs text-emerald-800">
                <div class="flex items-center space-x-2.5">
                    <i class="fa-brands fa-whatsapp text-2xl text-emerald-600"></i>
                    <div>
                        <div class="font-bold text-slate-800">Layanan Pemesanan Resmi WhatsApp</div>
                        <div>Fast response konsultasi & pengiriman medis</div>
                    </div>
                </div>
                <span class="bg-emerald-600 text-white font-semibold px-2.5 py-1 rounded-lg text-[10px]">Tersedia</span>
            </div>
        </div>

        <!-- Katalog Produk -->
        <main class="max-w-4xl mx-auto px-4 pb-12">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Katalog Produk Medis (<span id="total-produk-text">0</span>)</h2>
            </div>
            
            <div id="grid-produk" class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4"></div>

            <div id="produk-kosong" class="hidden text-center py-12">
                <i class="fa-solid fa-box-open text-4xl text-slate-300 mb-2"></i>
                <p class="text-slate-500 text-sm">Produk alat kesehatan tidak ditemukan.</p>
            </div>
        </main>
    </div>

    <!-- ==================== PANEL ADMIN ==================== -->
    <div id="admin-page" class="hidden w-full max-w-4xl mx-auto px-4 py-4">
        <div class="bg-slate-900 text-white rounded-2xl p-4 mb-4 flex justify-between items-center shadow-lg">
            <div>
                <span class="text-[10px] bg-alkes-600 px-2 py-0.5 rounded font-bold uppercase tracking-wider">Akses Terotorisasi</span>
                <h2 class="text-lg font-black mt-0.5 flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved text-alkes-500"></i> PANEL KONTROL ADMIN
                </h2>
            </div>
            <button onclick="keluarAdmin()" class="bg-rose-600 hover:bg-rose-700 text-white text-xs px-3.5 py-2 rounded-xl font-bold flex items-center gap-1.5 transition">
                <i class="fa-solid fa-right-from-bracket"></i> KELUAR
            </button>
        </div>

        <!-- Tab Navigasi Admin -->
        <div class="flex space-x-1.5 overflow-x-auto no-scrollbar bg-slate-200/80 p-1.5 rounded-xl mb-4 text-xs font-semibold">
            <button onclick="gantiTabAdmin('dashboard')" id="btn-tab-dashboard" class="tab-admin-btn px-3 py-2 rounded-lg bg-white text-slate-800 shadow">Dashboard</button>
            <button onclick="gantiTabAdmin('produk')" id="btn-tab-produk" class="tab-admin-btn px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900">Manajemen Produk</button>
            <button onclick="gantiTabAdmin('pesanan')" id="btn-tab-pesanan" class="tab-admin-btn px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900">Pesanan Masuk</button>
            <button onclick="gantiTabAdmin('pengaturan')" id="btn-tab-pengaturan" class="tab-admin-btn px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900">Pengaturan WA</button>
            <button onclick="gantiTabAdmin('user')" id="btn-tab-user" class="tab-admin-btn px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 whitespace-nowrap">Tambah User</button>
            <button onclick="gantiTabAdmin('password')" id="btn-tab-password" class="tab-admin-btn px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 whitespace-nowrap">Ganti Password</button>
        </div>

        <!-- 1. TAB DASHBOARD -->
        <section id="admin-sec-dashboard" class="space-y-4">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="text-slate-400 text-xs font-medium">Total Produk</div>
                    <div id="stat-total-produk" class="text-xl font-black text-alkes-700 mt-1">0</div>
                </div>
                <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="text-slate-400 text-xs font-medium">Total Pesanan</div>
                    <div id="stat-total-pesanan" class="text-xl font-black text-blue-600 mt-1">0</div>
                </div>
                <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="text-slate-400 text-xs font-medium">Pesanan Diproses</div>
                    <div id="stat-proses-pesanan" class="text-xl font-black text-amber-500 mt-1">0</div>
                </div>
                <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="text-slate-400 text-xs font-medium">Pesanan Selesai</div>
                    <div id="stat-selesai-pesanan" class="text-xl font-black text-emerald-600 mt-1">0</div>
                </div>
            </div>
            
            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
                <h3 class="font-bold text-sm text-slate-800 mb-2">Panduan Cepat Admin:</h3>
                <ul class="text-xs text-slate-600 space-y-1.5 list-disc list-inside">
                    <li>Gunakan menu <b>Manajemen Produk</b> untuk memperbarui harga dan stok langsung.</li>
                    <li>Status pesanan WhatsApp dapat diubah jadi <i>Diproses</i>, <i>Dikirim</i>, atau <i>Selesai</i>.</li>
                    <li>Atur nomor WhatsApp admin di tab <b>Pengaturan WA</b> agar pesanan pembeli terkirim ke nomor Anda.</li>
                </ul>
            </div>
        </section>

        <!-- 2. TAB MANAJEMEN PRODUK -->
        <section id="admin-sec-produk" class="hidden space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="font-bold text-sm text-slate-800">Daftar Inventaris Produk</h3>
                <button onclick="bukaModalProduk()" class="bg-alkes-600 hover:bg-alkes-700 text-white text-xs px-3 py-2 rounded-xl font-bold flex items-center gap-1 shadow">
                    <i class="fa-solid fa-plus"></i> Tambah Produk
                </button>
            </div>
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-600">
                        <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-200 uppercase text-[10px]">
                            <tr>
                                <th class="p-3">Foto & Nama</th>
                                <th class="p-3">Harga</th>
                                <th class="p-3">Stok</th>
                                <th class="p-3">Kategori</th>
                                <th class="p-3 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tabel-admin-produk" class="divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 3. TAB PESANAN -->
        <section id="admin-sec-pesanan" class="hidden space-y-4">
            <h3 class="font-bold text-sm text-slate-800">Daftar Pesanan Masuk via WhatsApp</h3>
            <div id="daftar-pesanan-admin" class="space-y-3"></div>
        </section>

        <!-- 4. TAB PENGATURAN WHATSAPP -->
        <section id="admin-sec-pengaturan" class="hidden space-y-4">
            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm max-w-lg">
                <h3 class="font-bold text-sm text-slate-800 mb-1">Pengaturan WhatsApp Toko</h3>
                <p class="text-xs text-slate-500 mb-4">Nomor ini menjadi tujuan saat pembeli menekan tombol 'Pesan melalui WhatsApp' dan saat checkout keranjang belanja.</p>
                
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Nomor WhatsApp Toko (Awali 62 / 08)</label>
                        <input type="text" id="input-wa-toko" class="w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-alkes-500">
                        <span class="text-[11px] text-slate-400">Contoh format: 081234567890 atau 6281234567890</span>
                    </div>
                    <button onclick="simpanNomorWA()" class="w-full bg-alkes-600 hover:bg-alkes-700 text-white font-bold py-2.5 rounded-xl text-xs transition">
                        SIMPAN NOMOR WHATSAPP
                    </button>
                </div>
            </div>
        </section>

        <!-- 5. TAB TAMBAH USER -->
        <section id="admin-sec-user" class="hidden space-y-4">
            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm max-w-lg">
                <div class="flex items-center gap-2 mb-2">
                    <i class="fa-solid fa-user-plus text-alkes-600 text-lg"></i>
                    <h3 class="font-bold text-sm text-slate-800">Tambah User Admin</h3>
                </div>
                <p class="text-xs text-slate-500 mb-4">Membuat akun Supabase baru yang bisa login ke Panel Admin. Akun baru memiliki akses admin penuh, jadi hanya tambahkan orang yang dipercaya.</p>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Email User Baru</label>
                        <input type="email" id="user-email" autocomplete="off" placeholder="user@email.com" class="w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-alkes-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
                        <input type="password" id="user-password" autocomplete="new-password" placeholder="Minimal 8 karakter" class="w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-alkes-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Konfirmasi Password</label>
                        <input type="password" id="user-konfirmasi" autocomplete="new-password" placeholder="Ulangi password" class="w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-alkes-500">
                    </div>
                    <label class="flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                        <input type="checkbox" onchange="['user-password','user-konfirmasi'].forEach(id => document.getElementById(id).type = this.checked ? 'text' : 'password')"> Tampilkan password
                    </label>
                    <button onclick="tambahUserBaru()" id="btn-tambah-user" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-xs transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-user-plus"></i> TAMBAH USER
                    </button>
                </div>
            </div>
        </section>

        <!-- 6. TAB GANTI PASSWORD -->
        <section id="admin-sec-password" class="hidden space-y-4">
            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm max-w-lg">
                <div class="flex items-center gap-2 mb-2">
                    <i class="fa-solid fa-lock text-alkes-600 text-lg"></i>
                    <h3 class="font-bold text-sm text-slate-800">Ganti Password Admin</h3>
                </div>
                <p class="text-xs text-slate-500 mb-4">Mengganti password akun admin Supabase yang dipakai untuk login (bukan kode rahasia).</p>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Password Lama</label>
                        <input type="password" id="pw-lama" autocomplete="current-password" placeholder="Masukkan password lama" class="w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-alkes-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Password Baru</label>
                        <input type="password" id="pw-baru" autocomplete="new-password" placeholder="Minimal 8 karakter" class="w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-alkes-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Konfirmasi Password Baru</label>
                        <input type="password" id="pw-konfirmasi" autocomplete="new-password" placeholder="Ulangi password baru" class="w-full p-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-alkes-500">
                    </div>
                    <label class="flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                        <input type="checkbox" onchange="['pw-lama','pw-baru','pw-konfirmasi'].forEach(id => document.getElementById(id).type = this.checked ? 'text' : 'password')"> Tampilkan password
                    </label>
                    <button onclick="simpanPasswordAdmin()" id="btn-simpan-password" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-xs transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-floppy-disk"></i> SIMPAN PASSWORD
                    </button>
                </div>
            </div>
        </section>
    </div>

    <!-- ==================== MODAL KERANJANG BELANJA & CHECKOUT ==================== -->
    <div id="modal-keranjang" class="fixed inset-0 bg-black/60 z-50 hidden flex justify-end">
        <div class="bg-white w-full max-w-md h-full flex flex-col justify-between shadow-2xl animate-in slide-in-from-right duration-300">
            <div class="p-4 bg-slate-900 text-white flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-cart-shopping text-alkes-500"></i>
                    <h3 class="font-bold text-sm tracking-wide">KERANJANG BELANJA</h3>
                </div>
                <button onclick="tutupKeranjang()" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="p-4 overflow-y-auto flex-1 space-y-4">
                <div id="isi-keranjang" class="space-y-2.5"></div>

                <div id="form-checkout-area" class="border-t border-slate-200 pt-4 space-y-3">
                    <h4 class="font-bold text-xs uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                        <i class="fa-solid fa-clipboard-user text-alkes-600"></i> Informasi Data Pembeli
                    </h4>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-600 mb-1">Nama Lengkap *</label>
                        <input type="text" id="checkout-nama" placeholder="Cth: Budi Santoso" class="w-full p-2 border border-slate-300 rounded-lg text-xs focus:ring-1 focus:ring-alkes-600 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-600 mb-1">Nomor WhatsApp Pembeli *</label>
                        <input type="tel" id="checkout-wa" placeholder="Cth: 0812XXXXXXXX" class="w-full p-2 border border-slate-300 rounded-lg text-xs focus:ring-1 focus:ring-alkes-600 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-600 mb-1">Alamat Lengkap Pengiriman *</label>
                        <textarea id="checkout-alamat" rows="2" placeholder="Nama Jalan, No. Rumah, RT/RW, Kecamatan, Kota/Kabupaten" class="w-full p-2 border border-slate-300 rounded-lg text-xs focus:ring-1 focus:ring-alkes-600 focus:outline-none"></textarea>
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-600 mb-1">Catatan Pesanan (Opsional)</label>
                        <input type="text" id="checkout-catatan" placeholder="Cth: Tolong packing kayu / Bubble wrap tebal" class="w-full p-2 border border-slate-300 rounded-lg text-xs focus:ring-1 focus:ring-alkes-600 focus:outline-none">
                    </div>
                </div>
            </div>

            <div class="p-4 bg-slate-50 border-t border-slate-200 space-y-3">
                <div class="space-y-1 text-xs">
                    <div class="flex justify-between text-slate-500">
                        <span>Total Jumlah Barang:</span>
                        <span id="cart-total-qty" class="font-semibold text-slate-700">0 pcs</span>
                    </div>
                    <div class="flex justify-between text-sm font-extrabold text-slate-800 pt-1 border-t border-slate-200">
                        <span>Subtotal:</span>
                        <span id="cart-total-harga" class="text-alkes-700">Rp 0</span>
                    </div>
                </div>
                <button onclick="prosesCheckoutWA()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2 shadow-lg transition">
                    <i class="fa-brands fa-whatsapp text-base"></i> Kirim Pesanan melalui WhatsApp
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL DETAIL PRODUK ==================== -->
    <div id="modal-detail" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-sm rounded-2xl overflow-hidden shadow-2xl animate-in zoom-in-95 duration-200 flex flex-col max-h-[90vh]">
            <div class="relative bg-slate-100 flex items-center justify-center h-48 border-b">
                <img id="detail-foto" src="" alt="Detail Produk" class="max-h-full object-contain p-2">
                <button onclick="tutupDetailModal()" class="absolute top-2.5 right-2.5 w-8 h-8 rounded-full bg-black/40 text-white flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                <span id="detail-kategori" class="absolute bottom-2 left-2 bg-alkes-700 text-white text-[10px] font-bold px-2 py-0.5 rounded-md"></span>
            </div>
            <div class="p-4 overflow-y-auto flex-1 space-y-2.5">
                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider" id="detail-merek"></div>
                <h3 class="font-extrabold text-slate-900 text-base" id="detail-nama"></h3>
                <div class="text-lg font-black text-alkes-700" id="detail-harga"></div>
                
                <div class="border-t border-slate-100 pt-2 space-y-1">
                    <span class="text-xs font-bold text-slate-700">Deskripsi & Spesifikasi:</span>
                    <p class="text-xs text-slate-600 leading-relaxed" id="detail-deskripsi"></p>
                </div>
                
                <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-200 flex justify-between text-xs">
                    <span class="text-slate-500">Ketersediaan Stok:</span>
                    <span class="font-bold text-slate-800" id="detail-stok"></span>
                </div>
            </div>
            <div class="p-3 bg-slate-50 border-t border-slate-200 grid grid-cols-2 gap-2">
                <button id="btn-tambah-detail" class="bg-alkes-100 hover:bg-alkes-200 text-alkes-800 font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-1.5">
                    <i class="fa-solid fa-cart-plus"></i> + Keranjang
                </button>
                <button id="btn-pesan-wa-detail" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-1.5">
                    <i class="fa-brands fa-whatsapp"></i> Pesan WA
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== MODAL TAMBAH / EDIT PRODUK ADMIN ==================== -->
