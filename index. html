        function tutupDetailModal() {
            document.getElementById('modal-detail').classList.add('hidden');
        }

        /* ================= PANEL ADMIN ================= */
        function gantiTabAdmin(tab) {
            ['dashboard', 'produk', 'pesanan', 'pengaturan', 'user', 'password'].forEach(t => {
                document.getElementById(`admin-sec-${t}`).classList.add('hidden');
                document.getElementById(`btn-tab-${t}`).className = "tab-admin-btn px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900";
            });

            document.getElementById(`admin-sec-${tab}`).classList.remove('hidden');
