        function bukaModalProduk() {
            document.getElementById('form-produk').reset();
            document.getElementById('edit-produk-id').value = '';
            document.getElementById('modal-form-judul').innerText = 'TAMBAH PRODUK BARU';
            document.getElementById('modal-form-produk').classList.remove('hidden');
        }

        function editProduk(id) {
            const p = daftarProduk.find(item => item.id === id);
            if (!p) return;

            document.getElementById('edit-produk-id').value = p.id;
            document.getElementById('form-nama').value = p.nama;
            document.getElementById('form-merek').value = p.merek;
            document.getElementById('form-kategori').value = p.kategori;
            document.getElementById('form-harga').value = p.harga;
            document.getElementById('form-stok').value = p.stok;
            document.getElementById('form-foto').value = p.foto;
            document.getElementById('form-deskripsi').value = p.deskripsi;

            document.getElementById('modal-form-judul').innerText = 'EDIT DATA PRODUK';
            document.getElementById('modal-form-produk').classList.remove('hidden');
        }

        function tutupModalProduk() {
            document.getElementById('modal-form-produk').classList.add('hidden');
        }

        function simpanProduk(e) {
            e.preventDefault();
            const editId = document.getElementById('edit-produk-id').value;
            const nama = document.getElementById('form-nama').value.trim();
            const merek = document.getElementById('form-merek').value.trim();
            const kategori = document.getElementById('form-kategori').value;
            const harga = parseInt(document.getElementById('form-harga').value);
            const stok = parseInt(document.getElementById('form-stok').value);
            let foto = document.getElementById('form-foto').value.trim();
            const deskripsi = document.getElementById('form-deskripsi').value.trim();

            if (!foto) {
                foto = "https://images.unsplash.com/photo-1584515933487-779824d29309?w=400&q=80";
            }

            if (editId) {
                const index = daftarProduk.findIndex(p => p.id === parseInt(editId));
                if (index !== -1) {
                    daftarProduk[index] = { ...daftarProduk[index], nama, merek, kategori, harga, stok, foto, deskripsi };
                    tampilkanToast("Data produk berhasil diperbarui!", "success");
                }
            } else {
                const idBaru = Date.now();
                daftarProduk.unshift({ id: idBaru, nama, merek, kategori, harga, stok, foto, deskripsi });
                tampilkanToast("Produk baru berhasil ditambahkan!", "success");
            }

            localStorage.setItem('alkes_produk', JSON.stringify(daftarProduk)); 
            dbSimpanProduk();
            tutupModalProduk();
            muatAdminData();
            renderKategori();
            cariDanFilterProduk();
        }

        function hapusProduk(id) {
            const p = daftarProduk.find(item => item.id === id);
            if (!p) return;

            if (confirm(`Apakah Anda yakin ingin menghapus produk "${p.nama}"?`)) {
                daftarProduk = daftarProduk.filter(item => item.id !== id);
                localStorage.setItem('alkes_produk', JSON.stringify(daftarProduk)); 
                dbSimpanProduk();
                tampilkanToast("Produk berhasil dihapus dari sistem", "info");
                muatAdminData();
                cariDanFilterProduk();
            }
        }

        function ubahStatusPesanan(idOrder, status) {
            const ord = daftarPesanan.find(o => o.id === idOrder);
            if (ord) {
                ord.status = status;
                localStorage.setItem('alkes_pesanan', JSON.stringify(daftarPesanan)); 
                dbSimpanPesanan(ord);
                tampilkanToast(`Status ${idOrder} diubah menjadi ${status}`, "success");
                muatAdminData();
            }
        }

        function simpanNomorWA() {
            const inputWA = document.getElementById('input-wa-toko').value.trim();
            if (!inputWA || inputWA.length < 8) {
                tampilkanToast("Masukkan nomor WhatsApp yang valid!", "warning");
                return;
            }
            nomorWaToko = inputWA;
            localStorage.setItem('alkes_wa_toko', nomorWaToko); 
            dbSimpanPengaturan();
            tampilkanToast("Nomor WhatsApp Toko berhasil disimpan!", "success");
        }

        async function simpanPasswordAdmin() {
            const lama = document.getElementById('pw-lama').value;
            const baru = document.getElementById('pw-baru').value;
            const konfirmasi = document.getElementById('pw-konfirmasi').value;
            const btn = document.getElementById('btn-simpan-password');

            if (!sb) return tampilkanToast("Supabase belum terhubung!", "error");
            if (!lama || !baru || !konfirmasi) return tampilkanToast("Semua kolom password wajib diisi!", "warning");
            if (baru.length < 8) return tampilkanToast("Password baru minimal 8 karakter!", "warning");
            if (baru !== konfirmasi) return tampilkanToast("Konfirmasi password baru tidak cocok!", "error");
            if (baru === lama) return tampilkanToast("Password baru harus berbeda dari password lama!", "warning");

            btn.disabled = true;
            try {
                const { data: sesi } = await sb.auth.getSession();
                const email = sesi && sesi.session && sesi.session.user ? sesi.session.user.email : null;
                if (!email) {
                    return tampilkanToast("Sesi login Supabase tidak ditemukan. Keluar, lalu login ulang dengan Email Supabase.", "warning");
                }

                // Verifikasi password lama
                const { error: errLama } = await sb.auth.signInWithPassword({ email, password: lama });
                if (errLama) return tampilkanToast("Password lama salah!", "error");

                const { error } = await sb.auth.updateUser({ password: baru });
                if (error) return tampilkanToast("Gagal mengganti password: " + error.message, "error");

                ['pw-lama', 'pw-baru', 'pw-konfirmasi'].forEach(id => document.getElementById(id).value = '');
                tampilkanToast("Password berhasil diganti!", "success");
            } catch (err) {
                tampilkanToast("Kendala: " + err.message, "error");
            } finally {
                btn.disabled = false;
            }
        }

        async function tambahUserBaru() {
            const email = document.getElementById('user-email').value.trim();
            const password = document.getElementById('user-password').value;
            const konfirmasi = document.getElementById('user-konfirmasi').value;
            const btn = document.getElementById('btn-tambah-user');

            if (!sb) return tampilkanToast("Supabase belum terhubung!", "error");
            if (!email || !password || !konfirmasi) return tampilkanToast("Semua kolom wajib diisi!", "warning");
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return tampilkanToast("Format email tidak valid!", "warning");
            if (password.length < 8) return tampilkanToast("Password minimal 8 karakter!", "warning");
            if (password !== konfirmasi) return tampilkanToast("Konfirmasi password tidak cocok!", "error");

            btn.disabled = true;
            try {
                const { data: sesi } = await sb.auth.getSession();
                if (!sesi || !sesi.session) {
                    return tampilkanToast("Sesi login Supabase tidak ditemukan. Keluar, lalu login ulang.", "warning");
                }

                // Klien terpisah tanpa penyimpanan sesi, agar login admin saat ini tidak tergantikan akun baru
                const sbBaru = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
                    auth: { persistSession: false, autoRefreshToken: false, detectSessionInUrl: false }
                });
                const { data, error } = await sbBaru.auth.signUp({ email, password });

                if (error) {
                    let pesan = error.message;
                    if (/already registered/i.test(pesan)) pesan = "Email sudah terdaftar!";
                    else if (/signups? (not allowed|are disabled)/i.test(pesan) || /disabled/i.test(pesan)) pesan = "Pendaftaran user dinonaktifkan di Supabase (aktifkan 'Allow new users to sign up').";
                    return tampilkanToast("Gagal menambah user: " + pesan, "error");
                }
                if (data.user && data.user.identities && data.user.identities.length === 0) {
                    return tampilkanToast("Email sudah terdaftar!", "error");
                }

                ['user-email', 'user-password', 'user-konfirmasi'].forEach(id => document.getElementById(id).value = '');
                if (data.session) {
                    tampilkanToast("User baru berhasil ditambahkan! Bisa langsung login.", "success");
                } else {
                    tampilkanToast("User dibuat. Email konfirmasi dikirim; user baru bisa login setelah konfirmasi.", "success");
                }
            } catch (err) {
                tampilkanToast("Kendala: " + err.message, "error");
            } finally {
                btn.disabled = false;
            }
        }

        function tampilkanToast(pesan, tipe = "info") {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let bg = "bg-slate-800 text-white";
            let ikon = '<i class="fa-solid fa-circle-info text-blue-400"></i>';

            if (tipe === "success") {
                bg = "bg-emerald-700 text-white";
                ikon = '<i class="fa-solid fa-circle-check text-emerald-200"></i>';
            } else if (tipe === "error") {
                bg = "bg-rose-700 text-white";
                ikon = '<i class="fa-solid fa-triangle-exclamation text-rose-200"></i>';
            } else if (tipe === "warning") {
                bg = "bg-amber-600 text-white";
                ikon = '<i class="fa-solid fa-circle-exclamation text-amber-200"></i>';
            }

            toast.className = `${bg} px-4 py-3 rounded-2xl shadow-xl flex items-center space-x-2.5 text-xs font-semibold animate-in fade-in slide-in-from-top-4 duration-300`;
            toast.innerHTML = `${ikon}<span>${pesan}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'transition', 'duration-300');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        /* RUN PERTAMA KALI */
        renderKategori();
        cariDanFilterProduk();
        perbaruiBadgeCart();
        inisialisasiDatabase();
    </script>
