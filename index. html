        }

        async function muatDariDatabase() {
            if (!sb) return;
            try {
                const [p, w] = await Promise.all([
                    sb.from('produk').select('data').order('id'),
                    sb.from('pengaturan').select('nilai').eq('kunci', 'wa_toko').maybeSingle()
                ]);
                if (!p.error && p.data && p.data.length) {
                    daftarProduk = p.data.map(x => x.data);
                    dbIdProduk = daftarProduk.map(x => x.id);
                    localStorage.setItem('alkes_produk', JSON.stringify(daftarProduk));
                } else if (!p.error && adminAktif) {
                    dbSimpanProduk();
                }
                if (!w.error && w.data) { 
                    nomorWaToko = w.data.nilai; 
                    localStorage.setItem('alkes_wa_toko', nomorWaToko); 
                }
                if (adminAktif) {
                    const o = await sb.from('pesanan').select('data').order('id', { ascending: false });
                    if (!o.error && o.data) daftarPesanan = o.data.map(x => x.data);
                }
            } catch (err) {
                console.error("Gagal muat dari Supabase:", err);
            }
            segarkanTampilan();
        }

