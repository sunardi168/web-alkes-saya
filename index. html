        /* ================= KERANJANG BELANJA ================= */
        function perbaruiBadgeCart() {
            const badge = document.getElementById('badge-cart');
            const totalQty = keranjang.reduce((sum, item) => sum + item.qty, 0);
            if (totalQty > 0) {
                badge.innerText = totalQty;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function tambahKeKeranjang(id) {
            const produk = daftarProduk.find(p => p.id === id);
            if (!produk) return;
            if (produk.stok <= 0) {
                tampilkanToast("Maaf, stok produk ini habis!", "error");
                return;
            }

            const itemDiKeranjang = keranjang.find(item => item.id === id);
            if (itemDiKeranjang) {
                if (itemDiKeranjang.qty >= produk.stok) {
                    tampilkanToast(`Stok hanya tersisa ${produk.stok} unit`, "warning");
                    return;
                }
                itemDiKeranjang.qty++;
            } else {
                keranjang.push({ ...produk, qty: 1 });
            }

            localStorage.setItem('alkes_cart', JSON.stringify(keranjang));
            perbaruiBadgeCart();
            tampilkanToast(`${produk.nama} masuk ke keranjang!`, "success");
        }

