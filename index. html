        function cariDanFilterProduk() {
            const query = document.getElementById('input-pencarian').value.toLowerCase().trim();
            const grid = document.getElementById('grid-produk');
            const emptyText = document.getElementById('produk-kosong');

            const filtered = daftarProduk.filter(item => {
                const matchKategori = (kategoriAktif === 'Semua') || (item.kategori === kategoriAktif);
                const matchNama = item.nama.toLowerCase().includes(query) || item.merek.toLowerCase().includes(query);
                return matchKategori && matchNama;
            });

            document.getElementById('total-produk-text').innerText = filtered.length;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyText.classList.remove('hidden');
                return;
            }

            emptyText.classList.add('hidden');
            grid.innerHTML = filtered.map(p => `
